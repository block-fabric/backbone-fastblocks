{
  "name": "chains-app-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HTML interface of chains-app, built into the binary.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/i18n.mjs --if-present && node scripts/build.mjs",
    "i18n": "node scripts/i18n.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "pack": "node scripts/i18n.mjs --if-present && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.2",
    "jsdom": "29.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "uqr": "0.1.3"
  }
}
