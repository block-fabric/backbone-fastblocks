# Turns the output of the frontend build into C++: every file as an array of
# bytes, and the table of them that BuiltinAssets() returns.
#   cmake -DDIST_DIR=<dir> -DOUTPUT=<file.cpp> -P embed.cmake
# The output depends on nothing but the files (sorted by path, no dates), so
# that builds are reproducible. It is only rewritten when it changes.

if(NOT DIST_DIR OR NOT OUTPUT)
  message(FATAL_ERROR "embed.cmake needs DIST_DIR and OUTPUT")
endif()
if(NOT EXISTS "${DIST_DIR}/index.html")
  message(FATAL_ERROR "No index.html in ${DIST_DIR}: the frontend build did not run")
endif()

file(GLOB_RECURSE files RELATIVE "${DIST_DIR}" "${DIST_DIR}/*")
list(SORT files)

set(arrays "")
set(table "")
set(index 0)
foreach(file IN LISTS files)
  if(file MATCHES "[\"\\\\]")
    message(FATAL_ERROR "Unexpected character in the name of ${file}")
  endif()
  file(READ "${DIST_DIR}/${file}" hex HEX)
  string(LENGTH "${hex}" hex_length)
  math(EXPR size "${hex_length} / 2")
  if(size EQUAL 0)
    string(APPEND arrays "const unsigned char a${index}[1]{0};\n")
  else()
    # 32 bytes a line.
    string(REGEX REPLACE "([0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f])" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND arrays "const unsigned char a${index}[]{\n${bytes}};\n")
  endif()
  string(APPEND table "    {\"/${file}\", {a${index}, ${size}}},\n")
  math(EXPR index "${index} + 1")
endforeach()

set(content "// Generated by src/webui/cmake/embed.cmake from the output of the frontend build. Do not edit.\n\n#include <webui/assets.h>\n\nnamespace webui {\nnamespace {\n${arrays}\nconst Asset ASSETS[]{\n${table}};\n} // namespace\n\nstd::span<const Asset> BuiltinAssets() { return ASSETS; }\n\n} // namespace webui\n")

file(WRITE "${OUTPUT}.new" "${content}")
file(COPY_FILE "${OUTPUT}.new" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.new")
